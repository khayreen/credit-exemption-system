# Application Configuration
APP_NAME="UiTM Credit Exemption System"
APP_ENV=local                          # Set to 'production' in production
APP_KEY=                               # Generate with: php artisan key:generate
APP_DEBUG=true                         # CRITICAL: Set to 'false' in production
APP_URL=http://localhost               # Update with production URL or IP
APP_TIMEZONE=Asia/Kuala_Lumpur         # Malaysia timezone
ADMIN_EMAIL=admin@example.com          # Admin email for notifications

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                        # Set to 'warning' or 'error' in production

# Database Configuration
# For development: Use SQLite
DB_CONNECTION=sqlite
# For production: Use MySQL
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=uitm_credit_system
# DB_USERNAME=uitm_user
# DB_PASSWORD=your_secure_password_here

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false            # Set to 'true' in production with HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# For development: Use 'log' driver (emails go to storage/logs)
MAIL_MAILER=log
# For production: Use 'smtp' (Gmail or other SMTP server)
# MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
# Production SMTP (Gmail example):
# MAIL_HOST=smtp.gmail.com
MAIL_PORT=2525
# Production SMTP port:
# MAIL_PORT=587
MAIL_USERNAME=null
# Production SMTP username:
# MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=null
# Production SMTP password:
# MAIL_PASSWORD=your-app-password-here
# Production SMTP encryption:
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
# Production from address:
# MAIL_FROM_ADDRESS=noreply@uitm.edu.my
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Cloud Vision API Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id-here
GOOGLE_CLOUD_CREDENTIALS_PATH=storage/app/keys/service-account-credentials.json
OCR_CONFIDENCE_THRESHOLD=0.8
OCR_MAX_FILE_SIZE=10240                # Maximum file size in KB (10MB)

# Google 2FA (Two-Factor Authentication) Configuration
OTP_ENABLED=true                       # Enable Google Authenticator 2FA
OTP_LIFETIME=0                         # OTP lifetime in minutes (0 = eternal)
