# Email Configuration Options for UiTM Credit Exemption System

# ====================================================================
# OPTION 1: LOG DRIVER (Immediate - No Setup Required) ✅
# Perfect for quick testing - emails appear in storage/logs/laravel.log
# ====================================================================
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@credit_system.test
MAIL_FROM_NAME="UiTM Credit System"

# ====================================================================
# OPTION 2: MAILTRAP (Recommended for Development)
# Sign up at https://mailtrap.io and get your credentials
# ====================================================================
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_mailtrap_username_here
# MAIL_PASSWORD=your_mailtrap_password_here
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@credit_system.test
# MAIL_FROM_NAME="UiTM Credit System"

# ====================================================================
# OPTION 3: GMAIL with App Password (For Production)
# Follow these steps:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Generate App Password (Select "Mail" and "Windows Computer")
# 4. Use the 16-character password below
# ====================================================================
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=kaiarenne00@gmail.com
# MAIL_PASSWORD=your_16_character_app_password_here
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=kaiarenne00@gmail.com
# MAIL_FROM_NAME="UiTM Credit System"

# ====================================================================
# OPTION 4: SENDGRID (Alternative Production Service)
# Sign up at https://sendgrid.com
# ====================================================================
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your_sendgrid_api_key_here
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@yourdomain.com
# MAIL_FROM_NAME="UiTM Credit System"
