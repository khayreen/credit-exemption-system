# ==================================================
# MAILTRAP CONFIGURATION (Development/Testing)
# ==================================================
# This configuration uses Mailtrap - a free email testing service
# All emails go to your Mailtrap inbox (not real users)
#
# Setup: https://mailtrap.io/register/signup
# ==================================================

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username_here
MAIL_PASSWORD=your_mailtrap_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@uitm.edu.my
MAIL_FROM_NAME="UiTM Credit System"

# ==================================================
# After updating, run:
# php artisan config:clear
# php artisan cache:clear
# ==================================================
